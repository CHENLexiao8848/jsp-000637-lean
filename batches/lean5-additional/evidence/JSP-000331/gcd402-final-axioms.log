Erdos402.erdos_402 :
  ∃ N₀, ∀ (A : Finset ℕ), N₀ ≤ A.card → 0 ∉ A → A.Nonempty → ∃ a ∈ A, ∃ b ∈ A, ↑(a.gcd b) ≤ ↑a / ↑A.card
JSP000331.solution :
  ∃ N₀, 2 ≤ N₀ ∧ ∀ (A : Finset ℕ), N₀ ≤ A.card → 0 ∉ A → ∃ a ∈ A, ∃ b ∈ A, a ≠ b ∧ ↑(a.gcd b) ≤ ↑a / ↑A.card
'Erdos402.erdos_402' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP000331.solution' depends on axioms: [propext, Classical.choice, Quot.sound]
