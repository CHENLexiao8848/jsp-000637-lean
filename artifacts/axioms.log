Jsp637.jsp_000637 :
  (∀ (ε : ℝ),
      0 < ε →
        ∃ N,
          ∀ (n : ℕ),
            N ≤ n → ∀ (F : Finset (Finset (Fin n))), ↑F.card ≤ (2 - ε) * 2 ^ (↑n / 2) → Jsp637.edgeCount F < 2 ^ n) ∧
    (¬∀ (c : ℝ),
          0 < c →
            ∃ C,
              0 < C ∧
                ∀ (n : ℕ) (F : Finset (Finset (Fin n))),
                  c * ↑F.card ^ 2 ≤ ↑(Jsp637.edgeCount F) → ↑F.card ≤ C * 2 ^ (↑n / 2)) ∧
      ∀ (ε : ℝ),
        0 < ε →
          ∃ δ,
            0 < δ ∧
              ∀ (n : ℕ) (F : Finset (Finset (Fin n))),
                ↑F.card ^ (2 - δ) < ↑(Jsp637.edgeCount F) → ↑F.card < (2 + ε) ^ (↑n / 2)
